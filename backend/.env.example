APP_NAME=ResolveAI
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3001

# Shared Supabase project with KnowledgePilot (ResolveAI uses resolveai_* tables only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120

CHECKPOINTER_BACKEND=sqlite
CHECKPOINT_DATABASE_PATH=.data/resolveai_checkpoints.sqlite

RETURN_WINDOW_DAYS=30
LATE_DELIVERY_GRACE_DAYS=3
MAX_SIMULATED_REFUND_AMOUNT=5000
APPROVAL_EXPIRY_HOURS=48
